{
    "name": "FreeRTOS NTP Development",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    
    // Container configuration
    "runArgs": [
        "--cap-add=SYS_TIME",
        "--cap-add=NET_ADMIN",
        "--cap-add=NET_RAW"
    ],
    
    // Set *default* container specific settings.json values on container create.
    "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.compilerPath": "/usr/bin/gcc",
        "C_Cpp.default.cStandard": "c11",
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x64"
    },

    // Add the IDs of extensions you want installed when the container is created.
    "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "eamodio.gitlens"
    ],

    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    "forwardPorts": [123],

    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "echo 'DevContainer created successfully!'",

    // Use 'postAttachCommand' to run commands each time you attach to the container
    "postAttachCommand": "cat .devcontainer/welcome.txt",

    // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
    "remoteUser": "vscode",

    // Container features
    "features": {
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": true,
            "upgradePackages": true,
            "configureZshAsDefaultShell": true,
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000"
        }
    },

    // Environment variables
    "containerEnv": {
        "FREERTOS_PATH": "/workspace/FreeRTOS-Kernel",
        "FREERTOS_TCP_PATH": "/workspace/FreeRTOS-Plus-TCP",
        "FREERTOS_PORT": "GCC/Posix"
    },

    // Lifecycle scripts
    "initializeCommand": "echo 'Initializing FreeRTOS NTP DevContainer...'",
    
    "onCreateCommand": {
        "clone-freertos": "git clone --depth 1 https://github.com/FreeRTOS/FreeRTOS-Kernel.git /workspace/FreeRTOS-Kernel || true",
        "clone-freertos-tcp": "git clone --depth 1 https://github.com/FreeRTOS/FreeRTOS-Plus-TCP.git /workspace/FreeRTOS-Plus-TCP || true"
    },

    // Mount the workspace folder to /workspaces/freertos-ntp
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/freertos-ntp,type=bind,consistency=cached",
    "workspaceFolder": "/workspaces/freertos-ntp",

    // Additional mounts for FreeRTOS
    "mounts": [
        "source=freertos-kernel,target=/workspace/FreeRTOS-Kernel,type=volume",
        "source=freertos-tcp,target=/workspace/FreeRTOS-Plus-TCP,type=volume"
    ]
}
